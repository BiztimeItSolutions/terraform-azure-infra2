# Terraform Override File Example
# Copy this file to terraform.tfvars.local and customize for your deployment
# This file is gitignored to prevent accidental credential commits

# ==========================================
# CRITICAL - CHANGE THESE VALUES
# ==========================================

# Admin password for RDP access
# Requirements: Min 12 chars, uppercase, lowercase, numbers, special chars
admin_password = "P@ssw0rd1234!"

# Restrict RDP access to your IP address
# Format: "203.0.113.42/32" or "203.0.113.0/24"
# DO NOT use "*" in production
rdp_source_ip = "*"  # Change this to your IP

# ==========================================
# OPTIONAL - Customize as needed
# ==========================================

# VM naming
vm_name = "vm-hawapay-scan-test"

# VM size options:
# - Standard_B2ms (2 vCPU, 8 GB RAM)
# - Standard_D2s_v3 (2 vCPU, 8 GB RAM)
# - Standard_D4s_v3 (4 vCPU, 16 GB RAM) - Default
# - Standard_D8s_v3 (8 vCPU, 32 GB RAM)
vm_size = "Standard_D4s_v3"

# Windows Server version
# - 2019-Datacenter
# - 2022-Datacenter-g2 (Recommended, newer)
vm_os_sku = "2022-datacenter-g2"

# Admin username
admin_username = "azureuser"

# Ansible configuration
ansible_user = "azureuser"

# Source code path (optional)
# Set to download/deploy source code automatically
# Format: "https://github.com/repo/archive/main.zip" or "/local/path/to/code"
source_code_path = ""

# Azure configuration
azure_subscription_id = "45fe6665-645e-4962-8eee-c409ea03a5r8"
azure_tenant_id       = "c8707d51-da13-42f0-9c86-c847b5a1c4ca"

# Resource naming
resource_group_name = "rg-hawapay-test"
location            = "uaenorth"
environment         = "test"
project_name        = "hawapay"

# Network configuration
vnet_name             = "vnet-hawapay-test"
subnet_name           = "vm-app"
vnet_address_space    = ["10.0.0.0/16"]
subnet_address_prefix = "10.0.1.0/24"

# Features
enable_diagnostics = true

# Tags for all resources
tags = {
  Environment = "test"
  Project     = "hawapay"
  ManagedBy   = "Terraform"
  Purpose     = "Security Scanning & Mobile Testing"
  Owner       = "DevOps Team"
  CostCenter  = "Engineering"
  CreatedDate = "2024-01-01"
}

# ==========================================
# ADVANCED OPTIONS
# ==========================================

# Storage account type for OS disk
# Premium_LRS (SSD) - Default
# Standard_LRS (HDD) - Lower cost
# StandardSSD_LRS (Standard SSD)
# storage_account_type = "Premium_LRS"

# OS disk size in GB
# os_disk_size_gb = 128

# ==========================================
# PRODUCTION RECOMMENDATIONS
# ==========================================

# 1. Use Azure Key Vault for password:
#    admin_password = data.azurerm_key_vault_secret.password.value
#
# 2. Use managed identity:
#    identity { type = "SystemAssigned" }
#
# 3. Enable backup:
#    backup_enabled = true
#
# 4. Use private endpoint:
#    private_endpoint_enabled = true
#
# 5. Add monitoring:
#    diagnostics_enabled = true
#    
# 6. Restrict networks:
#    rdp_source_ip = "203.0.113.0/24"  # Your office IP range
#
# 7. Use VPN:
#    network_access = "VPN_Only"
#
# 8. Enable encryption:
#    encryption_at_host = true

# ==========================================
# USAGE
# ==========================================
# 
# To use this file:
# 1. Copy to terraform.tfvars.local
# 2. Update with your values
# 3. Run: terraform apply -var-file="terraform.tfvars.local"
#
# Or set environment variables:
# export TF_VAR_admin_password="YourPassword"
# export TF_VAR_rdp_source_ip="YOUR.IP/32"
# terraform apply
