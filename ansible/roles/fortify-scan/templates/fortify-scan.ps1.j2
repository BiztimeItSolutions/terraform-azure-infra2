# Fortify Scan Script Template
# Usage: .\fortify-scan.ps1 -BuildName "MyProject" -SourcePath "C:\Users\azureuser\Desktop\SourceCode"

param(
    [string]$BuildName = "DefaultBuild",
    [string]$SourcePath = "C:\Users\{{ ansible_user }}\Desktop\SourceCode",
    [string]$ReportPath = "C:\Fortify\Reports"
)

$FortifyBin = "C:\Fortify\bin"
$SourceAnalyzer = "$FortifyBin\sourceanalyzer.exe"
$ReportGenerator = "$FortifyBin\ReportGenerator.exe"

Write-Host "========================================" -ForegroundColor Green
Write-Host "Fortify Scan Script" -ForegroundColor Green
Write-Host "========================================" -ForegroundColor Green

# Check Fortify installation
if (-not (Test-Path $SourceAnalyzer)) {
    Write-Host "ERROR: Fortify not found at $SourceAnalyzer" -ForegroundColor Red
    exit 1
}

Write-Host "Build Name: $BuildName" -ForegroundColor Cyan
Write-Host "Source Path: $SourcePath" -ForegroundColor Cyan
Write-Host "Report Path: $ReportPath" -ForegroundColor Cyan

# Create report directory
if (-not (Test-Path $ReportPath)) {
    New-Item -ItemType Directory -Path $ReportPath -Force | Out-Null
    Write-Host "Created report directory" -ForegroundColor Yellow
}

# Clean previous build
Write-Host "Cleaning previous build..." -ForegroundColor Yellow
& $SourceAnalyzer -b $BuildName -clean

# Scan source code
Write-Host "Scanning source code..." -ForegroundColor Yellow
$ScanStartTime = Get-Date
& $SourceAnalyzer -b $BuildName "$SourcePath"
$ScanEndTime = Get-Date

# Translate build
Write-Host "Translating build..." -ForegroundColor Yellow
& $SourceAnalyzer -b $BuildName -translate

# Scan
Write-Host "Running scan..." -ForegroundColor Yellow
& $SourceAnalyzer -b $BuildName -scan

# Generate report
Write-Host "Generating report..." -ForegroundColor Yellow
$ReportFile = "$ReportPath\$BuildName-$(Get-Date -Format 'yyyyMMdd-HHmmss').pdf"
& $ReportGenerator -b $BuildName -f $ReportFile -format pdf

Write-Host "========================================" -ForegroundColor Green
Write-Host "Scan Complete!" -ForegroundColor Green
Write-Host "Report saved to: $ReportFile" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Green
